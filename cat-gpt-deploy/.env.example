# Cat GPT backend environment variables
# Copy to .env for local dev. On Render, set these in the dashboard.
# Names verified against api/config.py, agent/graph.py, agent/voice.py,
# agent/tools.py, rag/ingest.py on 2026-10-12.

# ===== REQUIRED =====

# Groq API key (LLM + TTS) — get from console.groq.com
GROQ_API_KEY=

# Session token signing secret — any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Google Identity Services OAuth client ID (Google Cloud Console)
GOOGLE_CLIENT_ID=

# Allowed frontend origins, comma-separated (verified: api/config.py line 68)
FRONTEND_ORIGIN=http://localhost:3000,https://cat-gpt.vercel.app

# ===== OPTIONAL — code defaults are fine, list for reference =====

# All app data (SQLite DBs, uploads, FAISS index, media) lives here.
# Default: <repo-root>/data  — no need to set on Render.
#DATA_DIR=./data

# Hugging Face (required for realistic image generation via the FLUX chain)
#HF_API_KEY=
#HF_API_TOKEN=
#HF_IMAGE_MODEL=

# Voice / image / upload limits (defaults shown)
#GROQ_TTS_VOICE=Fritz-PlayAI
#SESSION_TTL_SECONDS=604800
#MAX_FILE_MB=25
#MAX_IMAGE_MB=10
#MAX_UPLOAD_FILES=10
#MAX_IMAGES_PER_REQUEST=3
#MAX_PROMPT_CHARS=8000

# Advanced path overrides (defaults are fine)
#UI_DB_PATH=
#UPLOAD_DIR=
